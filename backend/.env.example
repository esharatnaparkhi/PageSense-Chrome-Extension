# ─────────────────────────────────────────────────────────────────────────────
# PageSense Backend — Environment Variables
# Copy this file to .env and fill in every value marked <REQUIRED>.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
API_ENV=development
# Set to False in production. True only for local development.
DEBUG=True

# ── Security ─────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=<REQUIRED>
JWT_SECRET_KEY=<REQUIRED>

# ── Google OAuth ─────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=<REQUIRED>

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=<REQUIRED>
OPENAI_MODEL=gpt-4o

# ── MongoDB ───────────────────────────────────────────────────────────────────
# Local / Docker Compose default:
MONGODB_URL=mongodb://localhost:27017
# Railway internal networking example:
# MONGODB_URL=mongodb://mongo.railway.internal:27017
MONGODB_DB_NAME=pagesense

# ── Redis ─────────────────────────────────────────────────────────────────────
# Local / Docker Compose default:
REDIS_URL=redis://localhost:6379/0
# Railway internal networking example:
# REDIS_URL=redis://redis.railway.internal:6379/0

# ── Qdrant ────────────────────────────────────────────────────────────────────
# Local / Docker Compose default (internal network only — no public port):
QDRANT_URL=http://localhost:6333
# Railway internal networking (production):
# QDRANT_URL=http://qdrant.railway.internal:6333
QDRANT_COLLECTION_NAME=pagesense_embeddings

# REQUIRED — 64-character hex string.
# Generate with: python scripts/generate_qdrant_key.py
QDRANT_API_KEY=<REQUIRED>

# Must be the SAME value as QDRANT_API_KEY.
# This is the variable name Qdrant itself reads to enforce auth.
# Docker Compose loads this file into the qdrant service via env_file,
# so Qdrant picks it up automatically when you set it here.
QDRANT__SERVICE__API_KEY=<REQUIRED>

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Space-separated origins. Use your real frontend URL in production.
# CORS_ORIGINS=["https://yourapp.com"]

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=
PROMETHEUS_PORT=9090

# ── Content ───────────────────────────────────────────────────────────────────
MAX_PAGE_SIZE_MB=10
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_CHATS_PER_USER=3
MAX_QA_PER_CHAT_URL=200
REDIS_CACHE_TTL=86400
